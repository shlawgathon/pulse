# Pulse UX Optimizer - Backend Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DATABASE
# =============================================================================

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com
DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/pulse_ux?retryWrites=true&w=majority

# Redis URL for caching and sessions (optional)
# Use local: redis://localhost:6379
# Or hosted: redis://username:password@host:port
REDIS_URL=redis://localhost:6379

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT secret key for signing tokens
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# JWT token expiry (optional, defaults shown)
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Firecrawl API key for web scraping
# Get from: https://firecrawl.dev
FIRECRAWL_API_KEY=fc_your_firecrawl_api_key

# OpenRouter API key for Claude Opus 4.5
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key

# Resend API key for email notifications
# Get from: https://resend.com
RESEND_API_KEY=re_your_resend_api_key

# =============================================================================
# APPLICATION
# =============================================================================

# Application URL (for email links)
APP_URL=http://localhost:3000

# API URL (for CORS)
API_URL=http://localhost:8000

# Debug mode
DEBUG=true
