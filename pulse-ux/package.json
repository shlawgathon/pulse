{
  "name": "pulse-ux",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered UX optimization platform with automated A/B testing",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:web dev:api",
    "dev:web": "cd apps/web && bun run dev",
    "dev:api": "cd apps/api && uv run uvicorn src.main:app --reload --host 0.0.0.0 --port 8000",
    "build": "bun run build:web",
    "build:web": "cd apps/web && bun run build",
    "build:actuator": "cd packages/actuator && bun run build",
    "lint": "cd apps/web && bun run lint",
    "test": "bun run test:web test:api",
    "test:web": "cd apps/web && bun run test",
    "test:api": "cd apps/api && uv run pytest"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "bun@1.1.0"
}
